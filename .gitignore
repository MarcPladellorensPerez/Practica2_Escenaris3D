# .gitignore ajustado para Unity
# Este archivo debe ir en la raíz de tu proyecto

# Carpetas generadas por Unity (Causantes del error de +100MB)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Archivos de sistema y logs
*.log
.utmp/
sysinfo.txt
mono_crash.*

# Assets de Blender
*.blend1
*.blend1.meta

# Extensiones de editores y plugins (Rider, VS)
.vs/
.gradle/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Binarios y Builds finales
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Addressables y Visual Scripting
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Unity.VisualScripting.Generated/*

# Otros temporales
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*